{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linux-software-lab.invalid/schema/catalog.schema.json",
  "title": "Linux Software Lab catalogue",
  "type": "object",
  "required": ["schemaVersion", "software"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "software": {
      "type": "array",
      "items": { "$ref": "#/$defs/software" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "software": {
      "type": "object",
      "required": [
        "id", "name", "summary", "category", "status", "platforms",
        "tags", "detailUrl", "sourceUrl", "releaseUrl", "iconImage",
        "previewImage", "previewAlt"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "name": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "category": { "type": "string", "minLength": 1 },
        "status": { "enum": ["testing", "planned", "released"] },
        "platforms": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "tags": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "keywords": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "features": { "type": "array", "items": { "type": "string" } },
        "detailUrl": { "type": "string", "pattern": "^/software/[a-z0-9-]+\\.html$" },
        "sourceUrl": { "type": "string" },
        "releaseUrl": { "type": "string" },
        "iconImage": { "type": "string", "pattern": "^/assets/images/[a-z0-9-]+\\.svg$" },
        "previewImage": { "type": "string", "pattern": "^/assets/images/[a-z0-9-]+\\.svg$" },
        "previewAlt": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    }
  }
}
