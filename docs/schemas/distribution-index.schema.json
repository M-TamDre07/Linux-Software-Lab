{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linux-software-lab.vercel.app/data/distribution-index.schema.json",
  "title": "Linux Software Lab distribution index",
  "description": "Shared web/launcher registry of per-product version manifests. Artifacts and hashes stay in the versioned manifests, not in this index.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "updated_at",
    "detection_policy",
    "distributions",
    "products"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri-reference"
    },
    "schema_version": {
      "const": 1
    },
    "updated_at": {
      "type": "string",
      "format": "date"
    },
    "detection_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "native_launcher",
        "browser",
        "install_metadata"
      ],
      "properties": {
        "native_launcher": {
          "type": "string",
          "minLength": 1
        },
        "browser": {
          "type": "string",
          "minLength": 1
        },
        "install_metadata": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "distributions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "family",
          "label",
          "package_format",
          "package_manager",
          "source_formats",
          "note"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "family": {
            "enum": [
              "debian-family",
              "arch-family",
              "fedora-family",
              "suse-family",
              "unknown"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "package_format": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "deb",
              "rpm",
              "pkg.tar.zst",
              null
            ]
          },
          "package_manager": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "apt",
              "dnf",
              "zypper",
              "pacman",
              null
            ]
          },
          "source_formats": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "tar.gz",
                "zip"
              ]
            }
          },
          "note": {
            "type": "string",
            "minLength": 1
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "family": {
                  "const": "debian-family"
                }
              },
              "required": [
                "family"
              ]
            },
            "then": {
              "properties": {
                "package_format": {
                  "const": "deb"
                },
                "package_manager": {
                  "const": "apt"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "family": {
                  "const": "arch-family"
                }
              },
              "required": [
                "family"
              ]
            },
            "then": {
              "properties": {
                "package_format": {
                  "const": "pkg.tar.zst"
                },
                "package_manager": {
                  "const": "pacman"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "family": {
                  "const": "fedora-family"
                }
              },
              "required": [
                "family"
              ]
            },
            "then": {
              "properties": {
                "package_format": {
                  "const": "rpm"
                },
                "package_manager": {
                  "const": "dnf"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "family": {
                  "const": "suse-family"
                }
              },
              "required": [
                "family"
              ]
            },
            "then": {
              "properties": {
                "package_format": {
                  "const": "rpm"
                },
                "package_manager": {
                  "const": "zypper"
                }
              }
            }
          }
        ]
      }
    },
    "products": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "manifests"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "manifests": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "version",
                "url"
              ],
              "properties": {
                "version": {
                  "type": "string",
                  "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
                },
                "url": {
                  "type": "string",
                  "format": "uri",
                  "pattern": "^https://raw\\.githubusercontent\\.com/M-TamDre07/Linux-Software-Lab/main/apps/[a-z0-9-]+/releases/[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?/release\\.json$"
                }
              }
            }
          }
        }
      }
    }
  }
}
