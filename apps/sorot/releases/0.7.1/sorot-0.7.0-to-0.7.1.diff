+    plugins = _plugins_without_svg(tmp_path)
+    env = {**os.environ, "QT_QPA_PLATFORM": "offscreen"}
+    run = subprocess.run([sys.executable, "-I", "-c", _PROBE, str(plugins), str(ROOT / "src"), tone], capture_output=True, text=True, env=env, timeout=60)
+    assert run.returncode == 0, run.stderr
+    tick_pixels = int(run.stdout.strip().splitlines()[-1])
