+def _hflip(image):
+    """Horizontal mirror of a QImage: ``flipped`` exists from Qt 6.9, ``mirrored`` (deprecated later) before that."""
+    from PySide6.QtCore import Qt
+
+    return image.flipped(Qt.Orientation.Horizontal) if hasattr(image, "flipped") else image.mirrored(True, False)
+
+
+def _lightness_error(a, b) -> float:
+    total = sum(abs(a.pixelColor(x, y).lightness() - b.pixelColor(x, y).lightness()) for y in range(a.height()) for x in range(a.width()))
+    return total / (a.width() * a.height())
+
+
+def test_mirror_effect_really_paints_a_pixel_exact_horizontal_flip(qtbot):
+    """Regression (0.7.0): FlipEffect.draw unpacked a tuple that PySide6 never returns, so the first paint raised TypeError."""
+    from PySide6.QtWidgets import QLabel
+
+    from sorot.ui import appearance
+
+    label = QLabel("ABCDEFG")
+    label.setStyleSheet("background: white; color: black; font-size: 36px;")
+    label.resize(300, 80)
+    qtbot.addWidget(label)
+    label.show()
+    plain = label.grab().toImage()
+    appearance.set_mirrored(label, True)
+    flipped = label.grab().toImage()  # raised TypeError in 0.7.0
+    assert flipped.size() == plain.size()
+    assert _lightness_error(_hflip(plain), flipped) == 0
+    assert _lightness_error(plain, flipped) > 1, "the picture must actually have changed"
+    appearance.set_mirrored(label, False)
+    assert _lightness_error(plain, label.grab().toImage()) == 0, "removing the effect restores the original"
+
+
+def test_overlay_text_is_really_mirrored_when_mirror_mode_is_on(qtbot):
+    o = make_overlay(qtbot, "Teks cermin untuk beam-splitter")
+    o.show()
+    qtbot.waitExposed(o)
+    plain = o.text_view.grab().toImage()
+    o.set_appearance(mirror=True)
+    mirrored = o.text_view.grab().toImage()
+    assert _lightness_error(_hflip(plain), mirrored) < 1.0
+
+
