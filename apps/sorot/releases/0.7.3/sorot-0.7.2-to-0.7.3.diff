diff -ruN n2/sorot-0.7.2/scripts/sign-release.sh n3/sorot-0.7.3/scripts/sign-release.sh
--- n2/sorot-0.7.2/scripts/sign-release.sh	1970-01-01 07:00:00.000000000 +0700
+++ n3/sorot-0.7.3/scripts/sign-release.sh	2026-11-02 14:19:17.203605882 +0700
@@ -0,0 +1,11 @@
+#!/bin/bash
+# Sign dist/SHA256SUMS with your GPG key so downloads can be verified: `gpg --verify SHA256SUMS.asc SHA256SUMS`.
+# Usage: scripts/sign-release.sh KEYID [dist-dir]        (GNUPGHOME is honoured; nothing is uploaded)
+set -euo pipefail
+KEY="${1:?Gunakan: sign-release.sh KEYID [dist]}"
+DIR="${2:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/dist}"
+[ -f "$DIR/SHA256SUMS" ] || { echo "tidak ada $DIR/SHA256SUMS (jalankan make dist)" >&2; exit 1; }
+rm -f "$DIR/SHA256SUMS.asc"
+gpg --batch --yes --local-user "$KEY" --armor --detach-sign -o "$DIR/SHA256SUMS.asc" "$DIR/SHA256SUMS"
+gpg --batch --verify "$DIR/SHA256SUMS.asc" "$DIR/SHA256SUMS"
+echo "Ditandatangani: $DIR/SHA256SUMS.asc"
