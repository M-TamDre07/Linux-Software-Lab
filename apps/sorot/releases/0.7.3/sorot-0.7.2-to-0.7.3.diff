+def test_support_dialog_is_never_squeezed_by_larger_fonts(qtbot):
+    """Regression: with a larger font the window stayed shorter than its word-wrapped content and the GoPay card was cut off."""
+    from PySide6.QtGui import QFont
+    from PySide6.QtWidgets import QApplication, QLabel
+
+    from sorot.ui.dialogs import SupportDialog
+
+    app = QApplication.instance()
+    original = app.font()
+    bigger = QFont(original)
+    bigger.setPointSize(original.pointSize() + 4)
+    app.setFont(bigger)
+    try:
+        dialog = SupportDialog()
+        qtbot.addWidget(dialog)
+        dialog.show()
+        dialog.resize(500, 200)
+        qtbot.wait(50)
+        for label in dialog.findChildren(QLabel):
+            if label.isVisible():
+                need = label.heightForWidth(label.width()) if label.wordWrap() else label.minimumSizeHint().height()
+                assert label.height() >= need, f"{label.text()[:30]!r} terpotong: {label.height()} < {need}"
+    finally:
+        app.setFont(original)
