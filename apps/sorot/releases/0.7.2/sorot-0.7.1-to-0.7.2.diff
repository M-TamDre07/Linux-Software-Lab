         assert "Dinonaktifkan" in host.status("uji.host")
     finally:
         host.shutdown()
+
+
+GRANDCHILD_CODE = '''
+import subprocess, sys
+
+def activate(api):
+    def spawn(text):
+        child = subprocess.Popen([sys.executable, "-c", "import time; time.sleep(60)"])
+        return str(child.pid)
+    api.register_transform("spawn", "Anak", spawn)
+'''
+
+
+def _alive(pid: int) -> bool:
+    import os
+    try:
+        os.kill(pid, 0)
+    except ProcessLookupError:
+        return False
+    try:  # a zombie still answers kill(0)
+        return "Z" not in open(f"/proc/{pid}/stat").read().rsplit(")", 1)[1].split()[0]
+    except OSError:
+        return False
+
+
+@pytest.mark.skipif(not __import__("os").path.exists("/proc/self/stat"), reason="needs /proc")
+def test_stopping_an_extension_also_stops_processes_it_started(tmp_path):
+    process = ExtensionProcess(info_for(tmp_path, GRANDCHILD_CODE, "uji.anak"), APP)
+    process.start()
+    try:
+        pid = int(process.call("transform", {"id": "spawn", "text": "x"})["text"])
+        assert _alive(pid)
+        started = time.monotonic()
+        process.stop(kill=True)
+        assert time.monotonic() - started < 10, "stop() menunggu proses turunan"
+        deadline = time.monotonic() + 5
+        while _alive(pid) and time.monotonic() < deadline:
+            time.sleep(0.05)
+        assert not _alive(pid), "proses turunan ekstensi masih hidup setelah ekstensi dihentikan"
+    finally:
+        process.stop(kill=True)
