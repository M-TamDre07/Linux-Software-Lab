--- new/sorot-0.7.1/tests/test_integrity.py	1970-01-01 07:00:00.000000000 +0700
+++ n2/sorot-0.7.2/tests/test_integrity.py	2026-11-01 16:18:49.078918732 +0700
@@ -0,0 +1,49 @@
+"""Data-integrity regressions: hostile text must never make a save fail, and backups are never partial."""
+from __future__ import annotations
+
+import json
+
+from sorot.core.config import ConfigStore
+from sorot.core.fileio import atomic_write_text, scrub_text
+from sorot.core.scripts import DraftStore
+
+LONE = "A\ud800B\udc00C"
+
+
+def test_scrub_text_replaces_only_lone_surrogates():
+    assert scrub_text(LONE) == "A�B�C"
+    assert scrub_text("sudah baik — ✓ 😀") == "sudah baik — ✓ 😀"
+
+
+def test_atomic_write_never_fails_on_unencodable_text(tmp_path):
+    target = tmp_path / "x.txt"
+    atomic_write_text(target, LONE)
+    assert target.read_text(encoding="utf-8") in {"A?B?C", "A\ufffdB\ufffdC"}
+    assert not list(tmp_path.glob(".*.tmp"))
+
+
+def test_draft_with_lone_surrogates_is_saved(tmp_path):
+    draft = DraftStore(tmp_path / "draft.txt")
+    draft.save("halo " + LONE)
+    assert draft.load().startswith("halo ")
+
+
+def test_config_with_json_surrogate_escapes_loads_and_saves(tmp_path):
+    path = tmp_path / "config.json"
+    path.write_text(json.dumps({"schema_version": 4, "font_family": LONE, "last_directory": LONE}), encoding="utf-8")
+    store = ConfigStore(path)
+    loaded = store.load()
+    assert "\ud800" not in loaded.config.font_family
+    store.save(loaded.config)  # used to raise UnicodeEncodeError on every save
+    assert json.loads(path.read_text(encoding="utf-8"))["font_family"] == loaded.config.font_family
+
+
+def test_config_backup_is_a_complete_copy_and_leaves_no_temp_file(tmp_path):
+    path = tmp_path / "config.json"
+    store = ConfigStore(path)
+    config = store.load().config
+    store.save(config)
+    config.font_size += 1
+    store.save(config)
+    assert json.loads(store.backup_path.read_text(encoding="utf-8"))["font_size"] == config.font_size - 1
+    assert not list(tmp_path.glob(".*.tmp"))
diff -ruN new/sorot-0.7.1/tests/test_signals.py n2/sorot-0.7.2/tests/test_signals.py
--- new/sorot-0.7.1/tests/test_signals.py	1970-01-01 07:00:00.000000000 +0700
+++ n2/sorot-0.7.2/tests/test_signals.py	2026-11-01 16:18:49.076838539 +0700
@@ -0,0 +1,56 @@
+"""SIGTERM/SIGHUP/SIGINT must close the real application cleanly (save, release the lock, exit 0)."""
+from __future__ import annotations
+
+import os
+import signal
+import subprocess
+import sys
+import time
+from pathlib import Path
+
+import pytest
+
+SRC = Path(__file__).resolve().parents[1] / "src"
+pytestmark = pytest.mark.skipif(sys.platform == "win32", reason="POSIX signals")
+
+
+def _env(root: Path) -> dict[str, str]:
+    run = root / "run"
+    run.mkdir(parents=True, exist_ok=True)
+    run.chmod(0o700)
+    env = {k: v for k, v in os.environ.items() if not k.startswith(("XDG_", "SOROT_"))}
+    env.update(
+        HOME=str(root), XDG_DATA_HOME=str(root / "d"), XDG_CONFIG_HOME=str(root / "c"),
+        XDG_STATE_HOME=str(root / "s"), XDG_RUNTIME_DIR=str(run), QT_QPA_PLATFORM="offscreen",
+        PYTHONPATH=str(SRC),
+    )
+    return env
+
+
+def _wait_for(path_glob: Path, pattern: str, needle: str, timeout: float) -> bool:
+    end = time.monotonic() + timeout
+    while time.monotonic() < end:
+        for file in path_glob.glob(pattern):
+            if needle in file.read_text(encoding="utf-8", errors="replace"):
+                return True
+        time.sleep(0.1)
+    return False
+
+
+@pytest.mark.parametrize("sig", [signal.SIGTERM, signal.SIGHUP, signal.SIGINT])
+def test_a_termination_signal_closes_the_application_cleanly(tmp_path, sig):
+    root = tmp_path / "appdata"
+    root.mkdir()
+    proc = subprocess.Popen([sys.executable, "-m", "sorot"], env=_env(root), stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
+    try:
+        assert _wait_for(root / "s", "**/*.log", "Memulai Sorot", 30), "aplikasi tidak sempat mulai"
+        time.sleep(1.5)  # let the window and the signal bridge come up
+        proc.send_signal(sig)
+        code = proc.wait(timeout=20)
+    finally:
+        if proc.poll() is None:
+            proc.kill()
+            proc.wait()
+    assert code == 0, f"keluar dengan kode {code}"
+    assert (root / "c" / "sorot" / "config.json").is_file(), "pengaturan tidak disimpan saat ditutup"
+    assert _wait_for(root / "s", "**/*.log", "menutup dengan rapi", 2)
