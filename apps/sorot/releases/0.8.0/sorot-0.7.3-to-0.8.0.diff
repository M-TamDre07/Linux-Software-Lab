+"""Opening scripts from Word, OpenDocument, RTF, HTML, PDF and odd encodings, including hostile files."""
+from __future__ import annotations
+
+import zipfile
+
+import pytest
+
+from sorot.core.documents import LoadedScript, is_supported, load_script_file
+from sorot.core.fileio import ScriptFileError
+
+W = "http://schemas.openxmlformats.org/wordprocessingml/2006/main"
+
+
+def docx(path, paragraphs, *, doctype=""):
+    body = "".join(f"<w:p><w:r><w:t xml:space=\"preserve\">{p}</w:t></w:r></w:p>" for p in paragraphs)
+    xml = f'<?xml version="1.0" encoding="UTF-8"?>{doctype}<w:document xmlns:w="{W}"><w:body>{body}</w:body></w:document>'
+    with zipfile.ZipFile(path, "w", zipfile.ZIP_DEFLATED) as zf:
+        zf.writestr("[Content_Types].xml", "<Types/>")
+        zf.writestr("word/document.xml", xml)
+    return path
+
+
+def test_docx_paragraphs_tabs_and_breaks(tmp_path):
+    path = tmp_path / "a.docx"
+    xml = (f'<w:document xmlns:w="{W}"><w:body><w:p><w:r><w:t>Halo</w:t></w:r><w:r><w:tab/></w:r><w:r><w:t>dunia</w:t></w:r></w:p>'
+           f'<w:p><w:r><w:t>Baris</w:t><w:br/><w:t>dua ✓</w:t></w:r></w:p></w:body></w:document>')
+    with zipfile.ZipFile(path, "w") as zf:
+        zf.writestr("word/document.xml", xml)
+    loaded = load_script_file(path)
