diff -ruN n3/sorot-0.7.3/scripts/build-flatpak.sh n4/sorot-0.8.0/scripts/build-flatpak.sh
--- n3/sorot-0.7.3/scripts/build-flatpak.sh	1970-01-01 07:00:00.000000000 +0700
+++ n4/sorot-0.8.0/scripts/build-flatpak.sh	2026-11-06 09:03:21.601419584 +0700
@@ -0,0 +1,82 @@
+#!/bin/bash
+# Flatpak preparation: renders a flatpak-builder manifest for the current release.
+# Usage: scripts/build-flatpak.sh [output-dir] [--base-url https://host/path/to/release/files] [--build]
+#   Without --base-url the manifest points at the local tarball and wheel (for a trial build on this machine).
+#   With --base-url the manifest points at BASE/sorot-VERSION.tar.gz and BASE/sorot-VERSION-py3-none-any.whl
+#   with their SHA-256, which is the form Flathub requires. Nothing is uploaded.
+#   --build  also runs flatpak-builder (needs flatpak, flatpak-builder and the org.kde.Platform 6.8 runtime
+#            plus the io.qt.PySide.BaseApp 6.8 base app from Flathub; this was NOT possible in the build environment).
+# The Flatpak application id is derived from the GitHub account; confirm it with the Flathub reviewers.
+set -euo pipefail
+# shellcheck source=lib.sh
+. "$(dirname "${BASH_SOURCE[0]}")/lib.sh"
+
+BASE="" BUILD=0 ARGS=()
+while [ $# -gt 0 ]; do
+    case "$1" in
+        --base-url) BASE="${2:?--base-url butuh nilai}"; shift 2 ;;
+        --build) BUILD=1; shift ;;
+        *) ARGS+=("$1"); shift ;;
+    esac
+done
+OUT="$(absdir "${ARGS[0]:-$ROOT/dist}")"
+FP="$(absdir "$OUT/flatpak")"
+APPID="${SOROT_FLATPAK_ID:-io.github.M_TamDre07.Sorot}"
+"$ROOT/scripts/build-source.sh" "$FP" >/dev/null
