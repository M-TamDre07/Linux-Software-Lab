{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://muhammadandreatama.vercel.app/data/software.schema.json",
  "title": "Linux Software Lab catalog",
  "description": "Metadata contract for catalogued desktop and developer software.",
  "type": "object",
  "required": ["schemaVersion", "catalog", "software"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "catalog": {
      "type": "object",
      "required": ["name", "description", "searchMode", "pageSize", "updatedAt"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "searchMode": { "const": "client-side" },
        "pageSize": { "type": "integer", "minimum": 1, "maximum": 100 },
        "updatedAt": { "type": "string", "format": "date" }
      },
      "additionalProperties": false
    },
    "software": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id", "slug", "name", "version", "summary", "description", "category",
          "status", "type", "platforms", "tags", "keywords", "features",
          "detailUrl", "sourceUrl", "releaseUrl", "icon", "iconImage",
          "previewImage", "previewAlt", "updatedAt"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "name": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "summary": { "type": "string", "minLength": 1, "maxLength": 320 },
          "description": { "type": "string", "minLength": 1 },
          "category": { "type": "string", "minLength": 1 },
          "status": { "enum": ["released", "testing", "planned", "archived"] },
          "type": { "enum": ["desktop", "web", "cli", "library", "extension"] },
          "platforms": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "tags": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "keywords": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "features": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "detailUrl": { "type": "string", "pattern": "^/software/[a-z0-9-]+\\.html$" },
          "sourceUrl": { "type": "string", "format": "uri-reference" },
          "releaseUrl": { "type": "string", "format": "uri-reference" },
          "icon": { "type": "string", "minLength": 1 },
          "iconImage": { "type": "string", "pattern": "^/assets/images/[a-z0-9-]+\\.svg$" },
          "previewImage": { "type": "string", "pattern": "^/assets/images/[a-z0-9-]+\\.svg$" },
          "previewAlt": { "type": "string", "minLength": 1 },
          "updatedAt": { "type": "string", "format": "date" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
